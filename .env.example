# Or use a PG connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=NO_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public website address (canonical links, sitemap, social images, CORS for its
# forms). Defaults to NEXT_PUBLIC_SERVER_URL.
NEXT_PUBLIC_SITE_URL=

# CARTO basemaps key for the map (free, non-commercial: carto.com/basemaps/apikey).
# Public by design: it is inlined into the browser bundle.
NEXT_PUBLIC_CARTO_API_KEY=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional: URL the collections/globals webhook posts to when pages, posts, the header or
# the footer change. Leave empty and the plugin stays inert — nothing is called and writes
# are unaffected.
PAYLOAD_WEBHOOK_URL=

# Static build only. Base URL of the Payload REST API the frontend reads from —
# include /api, no trailing slash. Unset, the frontend reads this site's own
# /api, which is what the server build serves.
NEXT_PUBLIC_PAYLOAD_API_URL=

# Set to `static` by the static-site workflow. Unset for the server build.
NEXT_PUBLIC_BUILD_TARGET=
