# Or use a PG connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=NO_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional: Stadia Maps API key for the "Alidade Smooth" map style (matches B&W aesthetic).
# Without this key, the map falls back to CARTO Positron (free, no key required).
# Get a free key at: https://stadiamaps.com
NEXT_PUBLIC_STADIA_API_KEY=

# Base URL of the Payload REST API the frontend reads from. Include /api, no trailing slash
NEXT_PUBLIC_PAYLOAD_API_URL=https://new.alacrity.ro/api
